{
  "name": "@penmoss/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Shared React components, commands, themes, search UI, graph",
  "exports": {
    ".": "./src/index.ts",
    "./panels/Backlinks": "./src/panels/Backlinks.tsx",
    "./controls/Select": "./src/controls/Select.tsx",
    "./graph/GraphView": "./src/graph/GraphView.tsx",
    "./graph/GraphCanvas": "./src/graph/GraphCanvas.tsx",
    "./graph/model": "./src/graph/model.ts",
    "./graph/layout": "./src/graph/layout.ts",
    "./graph/renderer": "./src/graph/renderer.ts",
    "./graph/theme": "./src/graph/theme.ts",
    "./icons": "./src/icons/Icon.tsx",
    "./theme": "./src/theme/index.ts",
    "./theme/fonts": "./src/theme/fonts.ts",
    "./theme/schema": "./src/theme/schema.ts",
    "./theme/settings": "./src/theme/settings.ts",
    "./theme/tokens": "./src/theme/tokens.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests",
    "budgets": "PENMOSS_BUDGETS=1 vitest run"
  },
  "dependencies": {
    "@penmoss/core": "workspace:*",
    "d3-force": "3.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react-dom": "19.3.1",
    "vitest": "5.0.5"
  }
}
