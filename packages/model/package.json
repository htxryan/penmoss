{
  "name": "@penmoss/model",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The notes' and the workspace's Yjs documents, their records, comments, tags, history and the local search index: platform-free, shared by every client",
  "exports": {
    "./replica": "./src/replica.ts",
    "./yjs14": "./src/yjs14.ts",
    "./note": "./src/note.ts",
    "./workspace": "./src/workspace.ts",
    "./records": "./src/records.ts",
    "./tags": "./src/tags.ts",
    "./history": "./src/history.ts",
    "./comments": "./src/comments.ts",
    "./agent-sessions": "./src/agent-sessions.ts",
    "./comment-delivery": "./src/comment-delivery.ts",
    "./local-index": "./src/local-index.ts",
    "./record": "./src/record.ts",
    "./markdown": "./src/markdown.ts",
    "./edit-engine": "./src/edit-engine.ts",
    "./revert": "./src/revert.ts",
    "./capture": "./src/capture.ts",
    "./periodic": "./src/periodic.ts",
    "./title": "./src/title.ts",
    "./stats": "./src/stats.ts",
    "./note-fields": "./src/note-fields.ts",
    "./unsupported": "./src/unsupported.ts",
    "./description": "./src/description.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "perf": "vitest run --config vitest.perf.config.ts"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@penmoss/core": "workspace:*",
    "@y/prosemirror": "2.0.0-15",
    "@y/y": "14.0.0-rc.29",
    "lib0": "1.0.0-rc.36",
    "minisearch": "7.2.0",
    "prosemirror-model": "1.25.12"
  }
}
