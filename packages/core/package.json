    "./line-symbols": "./src/line-symbols.ts",
    "./schema": "./src/schema.ts",
    "./search": "./src/search/index.ts",
    "./note-text": "./src/search/note-text.ts",
    "./wikilinks": "./src/markdown/wikilink-syntax.ts",
    "./workspace": "./src/workspace/index.ts",
    "./tags": "./src/tags.ts",
    "./periodic": "./src/periodic.ts",
    "./diff": "./src/diff.ts",
    "./display": "./src/display.ts",
    "./fonts": "./src/fonts.ts",
