  "tracker": "linear",
  "github": {
    "project": {
      "owner": "htxryan",
      "number": 8
    },
    "status": {
      "pick": "Ready",
      "planning": "Planning",
      "working": "In progress",
      "review": "In review",
      "done": "Done"
    },
    "blockedField": "Blocked"
  },
  "linear": {
    "team": "PEN",
    "owner": "0e3e5023-dc54-4e93-a477-74c799f96ebb",
    "envFile": "~/.config/penmoss-factory/linear.env",
    "keychainItem": "penmoss-factory-linear",
    "status": {
      "pick": "Todo",
      "planning": "Planning",
      "working": "In Progress",
      "review": "In Review",
      "done": "Done"
    },
    "blockedLabel": "Blocked"
  },
  "owner": "htxryan",
  "planning": {
    "default": true,
    "skipLabel": "plan:skip",
    "agentMaySkipTrivial": true,
    "designWhenUx": true
  },
  "review": {
    "commentQuietMinutes": 3,
    "validationRounds": 2
  },
  "publisher": {
    "login": "penmoss-factory",
    "envFile": "~/.config/penmoss-factory/github-app.env"
  },
  "proof": {
    "bucket": "penmoss-factory-proof",
    "publicUrl": "https://proof.penmoss.app",
    "envFile": "~/.config/penmoss-factory/proof.env"
  },
  "envFile": "~/.config/penmoss-factory/factory.env",
  "stateDir": "~/Library/Application Support/penmoss-factory",
  "pollSeconds": 60,
  "maxConcurrent": 2,
  "worktreeRoot": "~/src/penmoss-wt",
  "branchPrefix": "factory/",
  "rounds": {
    "gateFix": 2,
    "ciRepair": 2
  },
  "timeouts": {
    "agentMinutes": 90,
    "proofMinutes": 40,
    "ciMinutes": 60
  },
  "slots": [
    {
      "id": 1,
      "portBlock": 1,
      "avd": "penmoss37-slot1",
      "emulatorPort": 5560,
      "adbServerPort": 5040
    },
    {
      "id": 2,
      "portBlock": 2,
      "avd": "penmoss37-slot2",
      "emulatorPort": 5562,
      "adbServerPort": 5041
    }
  ],
  "sharedDir": "/Users/Shared/penmoss-factory",
  "macProof": {
    "vm": "penmoss-test",
    "waitHours": 12
  },
  "agents": {
    "claude": {
      "bin": "claude",
      "defaultModel": "opus",
      "login": "~/.config/penmoss-factory/claude"
    },
    "opencode": {
      "bin": "opencode",
      "defaultModel": "go"
    }
  },
  "models": {
    "opus": {
      "agent": "claude",
      "model": "opus"
    },
    "sonnet": {
      "agent": "claude",
      "model": "sonnet"
    },
    "go": {
      "agent": "opencode",
      "model": "opencode-go/kimi-k3"
    }
  },
  "ui": {
    "port": 7878,
    "doneDays": 7
  },
  "toolchain": {
    "jdk": "/opt/homebrew/opt/openjdk@21",
    "androidSdk": "~/Library/Android/sdk",
    "playwrightBrowsers": "~/Library/Caches/ms-playwright"
  }
}
