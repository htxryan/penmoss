---

<SiteLayout
  title="All Features · Penmoss"
  description="Everything Penmoss does: agents through MCP and a CLI, notes in your own git repository, a real editor, search, journal, history, and apps for Mac and Android."
  current="features"
>
  <div class="wrap">
    <section class="section" aria-labelledby="features-title">
      <h1 id="features-title" class="page-title">All Features</h1>
      <p class="lede">
        Everything Penmoss does today. Each title links to the page in the docs that shows you how.
        Something missing? <a href={`${REPOSITORY}/issues/new/choose`}>Ask for it on GitHub</a>.
      </p>
      {
        groups.map((group) => (
          <section class="feature-group" aria-labelledby={`group-${group.id}`}>
            <h2 id={`group-${group.id}`}>{group.title}</h2>
            <ul class="feature-list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>{item.title}</a>
                  <p>{item.body}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </div>
</SiteLayout>
