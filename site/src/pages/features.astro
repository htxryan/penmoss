---

<SiteLayout
  title="All Features · Penmoss"
  description="Everything in Penmoss today: agents over MCP and the CLI, your notes in your own git repository, a block editor, search, history, a journal, and the Mac and Android apps."
  current="features"
>
  <section class="page-head" aria-labelledby="page-title">
    <div class="wrap">
      <h1 id="page-title">All Features</h1>
      <p class="lede">
        Everything in Penmoss today, on Mac and Android unless it says otherwise. Each feature links
        to its page in the <a href="/docs/">docs</a>.
      </p>
      <nav class="chips" aria-label="Feature groups">
        {groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
      </nav>
    </div>
  </section>

  {
    groups.map((group, index) => (
      <section id={group.id} class:list={['group', { alt: index % 2 === 1 }]}>
        <div class="wrap">
          <div class="group-head">
            <div class="group-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#2E5A3A"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={group.icon}
              />
            </div>
            <h2>{group.title}</h2>
          </div>
          <p class="group-lede" set:html={group.lede} />
          <div class="group-items">
            {group.items.map((item) => (
              <div class="group-item">
                <h3>
                  <a class="flink" href={item.href}>{item.title}<span class="arrow"><Arrow /></span></a>
                </h3>
                <p set:html={item.body} />
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="try" aria-labelledby="try-title">
    <div class="wrap">
      <h2 id="try-title">Try Penmoss</h2>
      <a class="btn-primary" href="/#download">Download</a>
    </div>
  </section>
</SiteLayout>
