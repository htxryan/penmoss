---
/**
 * penmoss.app's home page (T80.10, D64, P1, P9): written by hand, no script. Every feature claim
 * here is checked against the shipped app (the checklist is in the pull request). The download
 * links are GitHub's /releases/latest/download/ URLs (src/site.ts).
 */
import Icon from '../components/Icon.astro';
import SiteLayout from '../components/SiteLayout.astro';
import { DOWNLOADS, REPOSITORY, latestRelease } from '../site';

const release = latestRelease();
/** "v0.2.0 · 7 November 2026 · 140 MB", or nothing before a stable release exists (R3). */
const versionLine = (size: number | null) =>
  release
    ? [`v${release.version}`, release.date, size === null ? null : `${size} MB`]
        .filter(Boolean)
        .join(' · ')
    : null;

const features = [
  {
    title: 'Search by words or meaning',
    body: 'Full-text search everywhere. On the Mac, search by meaning runs on an on-device model, so your notes never leave it, and your agents get it too.',
    href: '/docs/search/',
  },
  {
    title: 'No sync conflicts',
    body: 'Edit the same note offline on your Mac and your phone. Penmoss merges both, with no conflict copies.',
    href: '/docs/help/sync/',
  },
  {
    title: 'Comments your agent answers',
    body: 'Comment on a passage and send it to an agent. It replies in the thread, and you resolve it when you are happy.',
    href: '/docs/agents/comments/',
  },
  {
    title: 'History for every note',
    body: 'See who changed what: you, another device or an agent. Restore any version, or revert one edit.',
    href: '/docs/history/',
  },
  {
    title: 'A real editor',
    body: 'A slash menu, tables, checklists, callouts, toggles, Mermaid diagrams, math, images and embedded notes. Markdown underneath.',
    href: '/docs/editor/',
  },
  {
    title: 'Mac and Android, offline first',
    body: 'Every device keeps a full copy and works without a connection. Sync is git, whenever you are back online.',
    href: '/docs/mac/',
  },
];
---

<SiteLayout
  title="Penmoss · Your Git. Your Agents. Your Notes."
  description="A free, open source notes app for Mac and Android. Markdown files in a private git repository you choose, and any AI agent can read and edit them through MCP or a CLI."
  current="home"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title">Your Git. Your Agents. <span class="notes">Your Notes.</span></h1>
      <p class="lede">
        Free, open-source notes app for Mac and Android. Markdown files in a private git repo you
        choose. Any agent can read and edit via MCP or CLI. No Penmoss server, no account, no
        subscription.
      </p>
      <div class="cta">
        <a class="button primary" href={DOWNLOADS.mac}><Icon name="laptop" /> Download for Mac</a>
        <a class="button secondary" href={DOWNLOADS.android}
          ><Icon name="phone" /> Get the Android APK</a
        >
      </div>
      <p class="oss-line">
        <a href={REPOSITORY}><Icon name="github" /> GitHub</a> · MIT
      </p>

      <ol class="strip" aria-label="How Penmoss connects">
        <li><strong>Penmoss</strong><span>Mac and Android</span></li>
        <li><strong>Your git repo</strong><span>Markdown files, yours</span></li>
        <li>
          <strong>Your agents</strong><span>Claude Code, Codex, OpenCode or any MCP agent</span>
        </li>
      </ol>

      <picture class="shot">
        <source
          srcset="/img/hero-dark.webp"
          media="(prefers-color-scheme: dark)"
          width="2880"
          height="1800"
        />
        <img
          src="/img/hero-light.webp"
          width="2880"
          height="1800"
          alt="Penmoss on the Mac: a project note with a table of milestones, a Mermaid diagram and a checklist, beside the notebook's folders and the calendar."
        />
      </picture>
    </div>
  </section>

  <section class="section" aria-labelledby="pillars-title">
    <div class="wrap">
      <h2 id="pillars-title">Your notes, and your agents, as equals</h2>
      <p class="lede">
        Penmoss is built on two ideas. Your notes belong to you, in a format any tool can read. And
        the AI agents you already use should be able to work with them, safely.
      </p>
      <div class="pillars">
        <article class="card pillar">
          <p class="eyebrow">Yours</p>
          <h3>Markdown in a git repository you own</h3>
          <ul>
            <li>Every note is a markdown file in a private repository you pick, on GitHub.</li>
            <li>Works offline on every device, and syncs through git when you are back.</li>
            <li>Readable without Penmoss: clone the repository and open the files.</li>
            <li>No account, no subscription, and no Penmoss server between you and your notes.</li>
          </ul>
          <a class="more" href="/docs/first-notebook/">How Notebooks Work</a>
        </article>
        <article class="card pillar">
          <p class="eyebrow">Agent-ready</p>
          <h3>Any agent can read and write, safely</h3>
          <ul>
            <li>
              A local MCP server and the <code>penmoss</code> CLI let agents search, read, write and
              keep your journal.
            </li>
            <li>Send a comment to an agent; it replies in the thread.</li>
            <li>
              Every agent edit is attributed in History, and one click reverts it without touching
              your own changes.
            </li>
            <li>Edits merge with your typing, so an agent never overwrites what you just wrote.</li>
          </ul>
          <a class="more" href="/docs/agents/">Connect Your Agent</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <h2 id="features-title">Everything a notes app should do, done well</h2>
      <p class="lede">
        A few of the things that make Penmoss different. <a href="/features">All Features</a> lists
        the rest.
      </p>
      <div class="grid">
        {
          features.map((feature) => (
            <article class="card">
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <a class="more" href={feature.href} aria-label={`Read the Docs: ${feature.title}`}>
                Read the Docs
              </a>
            </article>
          ))
        }
      </div>
      <p><a class="button secondary" href="/features">All Features</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title">How it works</h2>
      <p class="lede">
        Your git repository is the only shared place. Each device keeps a full copy and writes its
        own changes; each agent works through Penmoss on your Mac, so its edits merge and show in
        History like everyone else's.
      </p>
      <div class="how-wrap" role="region" aria-label="Diagram, scrolls sideways on small screens" tabindex="0">
      <svg
        class="how"
        viewBox="0 0 900 300"
        role="img"
        aria-labelledby="how-svg-title how-svg-desc"
        xmlns="http://www.w3.org/2000/svg"
      >
        <title id="how-svg-title">How Penmoss fits together</title>
        <desc id="how-svg-desc">
          The Mac app and the Android app each sync with your notebook's git repository on GitHub.
          On the Mac, Claude Code, Codex, OpenCode and other MCP agents reach your notes through the
          penmoss CLI and its local MCP server, which sync with the same repository.
        </desc>
        <rect class="box" x="20" y="40" width="220" height="80" rx="14"></rect>
        <text x="130" y="76" text-anchor="middle" font-weight="600" font-size="17">Mac app</text>
        <text class="small" x="130" y="100" text-anchor="middle" font-size="13">
          offline, full copy
        </text>
        <rect class="box" x="20" y="180" width="220" height="80" rx="14"></rect>
        <text x="130" y="216" text-anchor="middle" font-weight="600" font-size="17">Android app</text>
        <text class="small" x="130" y="240" text-anchor="middle" font-size="13">
          offline, full copy
        </text>
        <rect class="repo" x="340" y="100" width="220" height="100" rx="16"></rect>
        <text x="450" y="142" text-anchor="middle" font-weight="700" font-size="17">
          Your git repository
        </text>
        <text class="small" x="450" y="168" text-anchor="middle" font-size="13">
          markdown, history, on GitHub
        </text>
        <rect class="box" x="660" y="40" width="220" height="80" rx="14"></rect>
        <text x="770" y="72" text-anchor="middle" font-weight="600" font-size="17">
          penmoss CLI and MCP
        </text>
        <text class="small" x="770" y="98" text-anchor="middle" font-size="13">on your Mac</text>
        <rect class="box" x="660" y="180" width="220" height="80" rx="14"></rect>
        <text x="770" y="212" text-anchor="middle" font-weight="600" font-size="17">Your agents</text>
        <text class="small" x="770" y="238" text-anchor="middle" font-size="13">
          Claude Code, Codex, OpenCode
        </text>
        <path class="edge" d="M240 80C290 80 290 130 338 130"></path>
        <path class="edge" d="M240 220C290 220 290 170 338 170"></path>
        <path class="edge" d="M660 80C610 80 610 130 562 130"></path>
        <path class="edge" d="M770 180V122"></path>
        <text class="small" x="282" y="66" font-size="12">git</text>
        <text class="small" x="282" y="246" font-size="12">git</text>
        <text class="small" x="598" y="66" font-size="12">git</text>
        <text class="small" x="780" y="156" font-size="12">MCP or CLI</text>
      </svg>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="oss-title">
    <div class="wrap">
      <h2 id="oss-title">Open source, MIT licensed</h2>
      <p class="lede">
        All of Penmoss is on GitHub under the MIT licence: the Mac app, the Android app, the editor,
        the CLI and the MCP server. Read it, build it, change it.
      </p>
      <pre><code>git clone https://github.com/htxryan/penmoss
cd penmoss
task setup
task dev</code></pre>
      <p class="small-links">
        <a href={REPOSITORY}><Icon name="github" /> The repository</a>
        <a href={`${REPOSITORY}/blob/main/CONTRIBUTING.md`}>How to contribute</a>
        <a href="/docs/">Read the Docs</a>
      </p>
    </div>
  </section>

  <section class="section" id="download" aria-labelledby="download-title">
    <div class="wrap">
      <h2 id="download-title">Download</h2>
      <p class="lede">Both come straight from the latest stable release on GitHub.</p>
      <div class="downloads">
        <article class="card">
          <h3>Mac</h3>
          {versionLine(release?.mac ?? null) && <p class="version">{versionLine(release?.mac ?? null)}</p>}
          <ul class="facts">
            <li>Apple Silicon and Intel (universal)</li>
            <li>macOS 12 or later</li>
            <li>Signed and notarised by Apple</li>
          </ul>
          <a class="button primary" href={DOWNLOADS.mac}><Icon name="laptop" /> Download for Mac</a>
          <a href="/docs/install/mac/">Install Guide</a>
        </article>
        <article class="card">
          <h3>Android</h3>
          {
            versionLine(release?.android ?? null) && (
              <p class="version">{versionLine(release?.android ?? null)}</p>
            )
          }
          <ul class="facts">
            <li>Android 17 or later</li>
            <li>An APK you install yourself (sideload)</li>
            <li>The signing certificate's fingerprint is in the install guide</li>
          </ul>
          <a class="button primary" href={DOWNLOADS.android}
            ><Icon name="phone" /> Get the Android APK</a
          >
          <a href="/docs/install/android/">Install Guide</a>
        </article>
      </div>
      <p class="small-links">
        <a href={DOWNLOADS.alpha}>Alpha builds (every build from main)</a>
        <a href={DOWNLOADS.all}>All releases</a>
      </p>
    </div>
  </section>
</SiteLayout>
