---
/** The canvas's arrow after a link ("Read the Docs", "All Features", each feature's title). */
interface Props {
  size?: number;
  strokeWidth?: number;
}

const { size = 14, strokeWidth = 2.2 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
>
