---
/** A card under "Start here" on the docs home (Docs.dc.html). */
interface Props {
  href: string;
  title: string;
  icon: 'download' | 'git' | 'sparkle' | 'terminal';
  description: string;
}

const { href, title, icon, description } = Astro.props;
const ICONS = {
  download: '<path d="M12 4v12M6 11l6 6 6-6M5 20h14"></path>',
  git: '<circle cx="6" cy="5" r="2"></circle><circle cx="6" cy="19" r="2"></circle><circle cx="18" cy="9" r="2"></circle><path d="M6 7v10M18 11c0 4-6 3-11.5 6.5"></path>',
  sparkle: '<path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"></path>',
  terminal: '<path d="M4 17l6-5-6-5M12 19h8"></path>',
} as const;
---

<a class="pm-start-card" href={href}>
  <span class="pm-start-head"
    ><span class="pm-start-icon"
      ><svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#2E5A3A"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={ICONS[icon]}
      /></span
    ><b>{title}</b></span
  >
  <span class="pm-start-desc">{description}</span>
</a>
