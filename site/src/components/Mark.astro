---
/**
 * The Moss Pen (P13), drawn inline as on the design canvas: a cream tile in the header and the
 * docs, a paper tile in the footer. Decorative: the link beside it carries the name.
 */
interface Props {
  size: number;
  /** The tile's colour: cream on paper (the header), paper on cream (the footer). */
  ground?: 'cream' | 'paper';
}

const { size, ground = 'cream' } = Astro.props;
const fill = ground === 'cream' ? '#F3EEDF' : '#FBFAF6';
---

<svg width={size} height={size} viewBox="0 0 1024 1024" aria-hidden="true" focusable="false"
  ><rect width="1024" height="1024" rx="228" fill={fill}></rect><g
    transform="matrix(1.415 0 0 1.415 -212.5 -212.5)"
    ><path
      stroke="#2E5A3A"
      d="M436 250H340A90 90 0 0 0 250 340V684A90 90 0 0 0 340 774H684A90 90 0 0 0 774 684V340A90 90 0 0 0 684 250H588"
      fill="none"
      stroke-width="64"
      stroke-linecap="round"></path><path
      fill="#86AE5E"
      d="M336 712A90.4 90.4 0 0 1 369.6 565.1A75.9 75.9 0 0 1 457.6 474.2A65.3 65.3 0 0 1 566.4 474.2A75.9 75.9 0 0 1 654.4 565.1A90.4 90.4 0 0 1 688 712Z"
    ></path></g
  ></svg
>
