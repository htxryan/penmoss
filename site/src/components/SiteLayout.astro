---
/**
 * The brochure pages' frame (T80.10, T80.11, P9): head metadata, header and footer, as drawn on
 * the "Penmoss public release UX" design canvas. Light only, whatever the visitor's setting. No
 * script: the styles are inlined because the site-wide policy allows inline styles only.
 */
import Mark from './Mark.astro';
import siteCss from '../styles/site.css?raw';
import tokensCss from '../styles/tokens.css?raw';
import { REPOSITORY } from '../site';

interface Props {
  title: string;
  description: string;
  /** The header link to mark as the current page. */
  current?: 'home' | 'features';
  /** Leave the page out of search engines (the 404 page). */
  noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/img/social.png', Astro.site).href;
const year = 2026;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Penmoss" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Penmoss: Your Git. Your Agents. Your Notes. A free, open source notes app for Mac and Android."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <style is:inline set:html={tokensCss + siteCss}></style>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={current === 'home' ? '#top' : '/'}>
          <Mark size={32} />
          <span>Penmoss</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a
            class="navlink"
            href="/features"
            aria-current={current === 'features' ? 'page' : undefined}>Features</a
          >
          <a class="navlink" href="/docs/">Docs</a>
          <a class="navlink github" href={REPOSITORY}
            ><svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path
                d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
              ></path></svg
            >GitHub</a
          >
          <a class="btn-primary" href={current === 'home' ? '#download' : '/#download'}>Download</a>
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-brand"><Mark size={24} ground="paper" />© {year} Ryan Henderson</div>
        <nav class="footer-nav" aria-label="Footer">
          <a class="navlink" href="/features">Features</a>
          <a class="navlink" href="/docs/">Docs</a>
          <a class="navlink" href="/privacy">Privacy</a>
          <a class="navlink" href={REPOSITORY}>GitHub</a>
          <a class="navlink" href={`${REPOSITORY}/blob/main/LICENSE`}>MIT Licensed</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
