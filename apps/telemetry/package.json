{
  "name": "@penmoss/telemetry",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Usage analytics' ingest Worker (PEN-137) on t.penmoss.app: POST /v1/batch and /v1/forget into D1, a nightly rollup and prune, and the named queries",
  "exports": {
    "./queries": "./src/queries.ts",
    "./params": "./src/params.ts",
    "./day": "./src/day.ts"
  },
  "scripts": {
    "dev": "wrangler dev --local --port $(node ../../scripts/ports.mjs telemetry) --inspector-port $(node ../../scripts/ports.mjs inspector)",
    "types": "wrangler types --include-runtime=false --env-file /dev/null && wrangler types --include-env=false ../../types/workers-runtime.d.ts",
    "types:check": "wrangler types --include-runtime=false --env-file /dev/null --check && wrangler types --include-env=false --check ../../types/workers-runtime.d.ts",
    "typecheck": "pnpm run types:check && tsc --noEmit -p .",
    "test": "vitest run && node --test scripts/query.test.mjs",
    "query": "node scripts/query.mjs",
    "deploy": "sh ../../scripts/no-factory-deploy.sh && wrangler d1 migrations apply penmoss-telemetry --remote && wrangler deploy"
  },
  "dependencies": {
    "@penmoss/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@types/node": "24.19.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
