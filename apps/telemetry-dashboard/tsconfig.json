{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/vitest-plugin/types", "node"]
  },
  "include": [
    // This Worker's Env (worker-configuration.d.ts) and the runtime types the three Workers share,
    // for one compatibility date and its flags; `pnpm types` writes both, typecheck checks them.
    "worker-configuration.d.ts",
    "../../types/workers-runtime.d.ts",
    "src",
    "test",
    "vitest.config.ts",
    "vitest.workers.config.ts"
  ],
  // The page (DOM) and the Playwright spec (Node) have their own, and they check the recorded
  // sessions both read (test/fixtures, PEN-178).
  "exclude": ["src/client", "test/client", "test/e2e", "test/fixtures"]
}
