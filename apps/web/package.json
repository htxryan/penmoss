    "e2e": "playwright test",
    "budgets": "PENMOSS_BUDGETS=1 vitest run"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@penmoss/core": "workspace:*",
    "@penmoss/editor": "workspace:*",
    "@penmoss/git-notebook": "workspace:*",
    "@penmoss/sync-client": "workspace:*",
    "@penmoss/ui": "workspace:*",
    "gpt-tokenizer": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
