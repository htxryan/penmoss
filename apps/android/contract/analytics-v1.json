    "scroll"
  ],
  "clients": ["mac", "android", "cli", "mcp"],
  "actors": ["person", "agent", "script"],
  "channels": ["stable", "alpha", "dev"],
  "oses": ["macos", "android", "linux", "windows", "other"],
  "sizeClasses": ["compact", "medium", "expanded"],
  "countBuckets": [
    "0",
    "1",
    "2–4",
    "5–9",
    "10–49",
    "50–99",
    "100–499",
    "500–999",
    "1000–4999",
    "5000+"
  ],
  "durationBuckets": ["<1s", "1–2s", "2–5s", "5–15s", "15–60s", "1–5m", "5–30m", "30m+"],
  "states": [
    {
      "name": "pending",
      "code": 0,
      "label": "Waiting for Your Answer"
    },
    {
      "name": "local",
      "code": 1,
      "label": "Not Shared"
    },
    {
      "name": "waiting",
      "code": 2,
      "label": "Waiting to Send"
    },
    {
      "name": "sent",
      "code": 3,
      "label": "Sent"
    },
    {
      "name": "refused",
      "code": 4,
      "label": "Refused"
    }
  ],
  "stateOrder": ["pending", "waiting", "sent", "local", "refused"],
  "patterns": {
    "eventId": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){1,4}$",
    "install": "^[0-9a-f]{32}$",
    "session": "^[0-9a-f]{16}$",
    "version": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}(?:-[a-z0-9.]{1,20})?$",
    "osVersion": "^\\d{1,4}(?:\\.\\d{1,4})?$",
    "keys": "^(?:(?:Mod|Ctrl|Alt|Shift|Meta|Cmd|Option)\\+){0,4}(?:[A-Z0-9]|F\\d{1,2}|[\\x5B\\]\\\\;',./`=-]|Enter|Escape|Tab|Space|Backspace|Delete|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|Home|End|PageUp|PageDown)$"
