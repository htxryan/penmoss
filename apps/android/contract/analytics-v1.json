{
  "$comment": "The usage analytics event format (PEN-137), written from packages/core/src/analytics by packages/core/test/analytics-contract.test.ts, which also checks it. Android records events in this format and checks them as validate.ts does: a name must be in `catalogue` under its kind, and each prop one of `props` for its kind (`enum`: one of `values`; `bool`; `count`: one of `countBuckets`; `duration`: one of `durationBuckets`; `keys`: matches `patterns.keys`; `flags`: at most `maxFlags` names matching `patterns.flag`; `setting`: a boolean, a whole number 0 to `maxSettingNumber`, a count bucket or a word matching `patterns.settingToken`; `screen`: a name in `catalogue.screen`). States are stored as their `code`. The catalogue only grows.",
  "version": 1,
  "kinds": [
    "app",
    "command",
    "screen",
    "dialog",
    "click",
    "menu",
    "setting",
    "firstrun",
    "feedback",
    "sync",
    "cli",
    "tool"
  ],
  "clients": ["mac", "android", "cli", "mcp"],
  "actors": ["person", "agent", "script"],
  "channels": ["stable", "alpha", "dev"],
  "oses": ["macos", "android", "linux", "windows", "other"],
  "sizeClasses": ["compact", "medium", "expanded"],
  "countBuckets": [
    "0",
    "1",
    "2–4",
    "5–9",
    "10–49",
    "50–99",
    "100–499",
    "500–999",
    "1000–4999",
    "5000+"
  ],
  "durationBuckets": ["<1s", "1–2s", "2–5s", "5–15s", "15–60s", "1–5m", "5–30m", "30m+"],
  "states": [
    {
      "name": "pending",
      "code": 0,
      "label": "Waiting for Your Answer"
    },
    {
      "name": "local",
      "code": 1,
      "label": "Not Shared"
    },
    {
      "name": "waiting",
      "code": 2,
      "label": "Waiting to Send"
    },
    {
      "name": "sent",
      "code": 3,
      "label": "Sent"
    },
    {
      "name": "refused",
      "code": 4,
      "label": "Refused"
    }
  ],
  "stateOrder": ["pending", "waiting", "sent", "local", "refused"],
  "patterns": {
    "eventId": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){1,4}$",
    "install": "^[0-9a-f]{32}$",
    "session": "^[0-9a-f]{16}$",
    "version": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}(?:-[a-z0-9.]{1,20})?$",
    "osVersion": "^\\d{1,4}(?:\\.\\d{1,4})?$",
    "keys": "^(?:(?:Mod|Ctrl|Alt|Shift|Meta|Cmd|Option)\\+){0,4}(?:[A-Z0-9]|F\\d{1,2}|[\\x5B\\]\\\\;',./`=-]|Enter|Escape|Tab|Space|Backspace|Delete|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|Home|End|PageUp|PageDown)$",
    "flag": "^[a-z][a-z0-9-]{0,31}$",
    "settingToken": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
  },
  "maxFlags": 16,
  "maxSettingNumber": 10000000,
  "sending": {
    "maxBatchEvents": 200,
    "maxBatchBytes": 65536,
    "everyMs": 60000,
    "atWaiting": 25,
    "timeoutMs": 10000,
    "maxBackoffMs": 3600000
  },
  "agentClients": [
    "claude-code",
    "claude-desktop",
    "codex",
    "cursor",
    "vscode",
    "windsurf",
    "zed",
    "gemini",
    "goose",
    "cline",
    "continue",
    "penmoss",
    "other"
  ],
  "limits": [
    {
      "key": "events.days",
      "default": 7,
      "min": 1,
      "max": 360,
      "unit": "days",
      "group": "usage"
    },
    {
      "key": "events.max",
      "default": 5000,
      "min": 500,
      "max": 800000,
      "unit": "events",
      "group": "usage"
    },
    {
      "key": "logs.fileKb",
      "default": 1024,
      "min": 256,
      "max": 81920,
      "unit": "KB",
      "group": "logs"
    },
    {
      "key": "logs.files",
      "default": 2,
      "min": 1,
      "max": 5,
      "unit": "files",
      "group": "logs"
    },
    {
      "key": "logs.days",
      "default": 7,
      "min": 1,
      "max": 360,
      "unit": "days",
      "group": "logs"
    },
    {
      "key": "report.hours",
      "default": 24,
      "min": 1,
      "max": 168,
      "unit": "hours",
      "group": "report"
    },
    {
      "key": "report.lines",
      "default": 300,
      "min": 50,
      "max": 2000,
      "unit": "lines",
      "group": "report"
    },
    {
      "key": "report.kb",
      "default": 16,
      "min": 4,
      "max": 40,
      "unit": "KB",
      "group": "report"
    }
  ],
